# Copy this file to .env (or set these as real environment variables wherever this app runs -
# locally, Docker, Render, etc.) and fill in real values. Never commit the filled-in file -
# only this example, with placeholders, belongs in git.

# MongoDB connection string for the app's database.
SUDOKU_MONGO_DB_URI=

# Secret key used to sign/verify this app's JWTs (both real-user and guest tokens). Required,
# no fallback - keep it secret and stable across restarts, or every previously issued token
# is invalidated.
SUDOKU_JWT_SECRET=

# Set to true wherever the app is served over HTTPS (e.g. Render), so the guest-session cookie
# gets the Secure flag. Defaults to false, which is correct for local HTTP dev.
COOKIE_SECURE=false

# App log level (e.g. DEBUG to troubleshoot). Defaults to INFO.
LOG_LEVEL=INFO

# Google OAuth2 client credentials for Google sign-in (Google Cloud Console project
# sudokubattle-508816). The console's authorized redirect URI must match {origin}/authCallback
# for whichever origin this app is served from.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail account used to send password-reset emails via SMTP. GMAIL_APP_PASSWORD must be a
# Google-generated "app password" (Google Account > Security > App passwords), not the account's
# real login password.
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# Origin the password-reset email link points to (the frontend's own origin). Defaults to the
# local Vite dev server; set to the deployed origin (e.g. https://sudokubattle.onrender.com) in
# production.
APP_BASE_URL=http://localhost:5173