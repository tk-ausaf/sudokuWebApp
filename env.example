# Copy this file to .env (or set these as real environment variables wherever this app runs -
# locally, Docker, Render, etc.) and fill in real values. Never commit the filled-in file -
# only this example, with placeholders, belongs in git.

# MongoDB connection string for the app's database.
SUDOKU_MONGO_DB_URI=

# Secret key used to sign/verify this app's JWTs (both real-user and guest tokens). Required,
# no fallback - keep it secret and stable across restarts, or every previously issued token
# is invalidated.
SUDOKU_JWT_SECRET=

# App log level (e.g. DEBUG to troubleshoot). Defaults to INFO.
LOG_LEVEL=INFO

# Google OAuth2 client credentials for Google sign-in (Google Cloud Console project
# sudokubattle-508816). The console's authorized redirect URI must match {origin}/authCallback
# for whichever origin this app is served from.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail account used to send password-reset emails via SMTP. GMAIL_APP_PASSWORD must be a
# Google-generated "app password" (Google Account > Security > App passwords), not the account's
# real login password.
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# The frontend's own deployed origin - used for the password-reset email link and the redirect
# back after Google login. Defaults to the local Vite dev server; set to the frontend's deployed
# URL (its own separate service, not the backend's) in production. Set on the BACKEND (Render).
APP_BASE_URL=http://localhost:5173

# --- Frontend-side (Vercel project settings), not read by the Spring Boot app above ---
# Only relevant to a Vercel deployment (or `vercel dev`) - plain `npm run dev` never touches
# these, since vite.config.js's own proxy already forwards everything to localhost:8080 for you.

# The real backend's origin. Read server-side, at request time, by the reverse-proxy serverless
# function (frontend/api/proxy/[...path].js) that makes REST calls same-origin for the browser -
# see vercel.json's `rewrites`. Plain project env var, NOT prefixed VITE_ (never shipped to the
# browser bundle). Changing hosts later (e.g. to AWS/Azure) is exactly this one value, no redeploy
# of the proxy function's code required.
BACKEND_ORIGIN=

# The same backend origin, but baked into the frontend's JS bundle at build time (Vite only
# supports build-time env vars, not runtime config) - needed for the two things that can't go
# through the same-origin proxy above: the multiplayer WebSocket (frontend/src/hooks/
# useMultiplayerSocket.js) and the "Sign in with Google" link (frontend/src/api/client.js). Keep
# this equal to BACKEND_ORIGIN. Changing hosts later means rebuilding/redeploying the frontend,
# unlike BACKEND_ORIGIN above.
VITE_BACKEND_ORIGIN=