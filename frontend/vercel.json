{
  "rewrites": [
    { "source": "/sudoku/:path*", "destination": "/api/proxy?forwardPath=/sudoku/:path*" },
    { "source": "/users", "destination": "/api/proxy?forwardPath=/users" },
    { "source": "/users/:path*", "destination": "/api/proxy?forwardPath=/users/:path*" },
    { "source": "/multiplayer/games", "destination": "/api/proxy?forwardPath=/multiplayer/games" },
    { "source": "/multiplayer/games/:path*", "destination": "/api/proxy?forwardPath=/multiplayer/games/:path*" },
    { "source": "/visitors/:path*", "destination": "/api/proxy?forwardPath=/visitors/:path*" },
    { "source": "/health", "destination": "/api/proxy?forwardPath=/health" },
    { "source": "/((?!api/|sudoku/|users|multiplayer/|visitors/|health).*)", "destination": "/index.html" }
  ]
}